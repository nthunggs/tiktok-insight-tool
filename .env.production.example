# ─── Production .env (copy thành .env trên server, sửa giá trị) ───

# Random 32+ ký tự — tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_random_long_string_32_chars_min_for_session_signing

# Set "true" nếu deploy qua HTTPS (cookie chỉ gửi qua TLS, chống session sniff)
# SESSION_COOKIE_SECURE=true

# ─── Lark OAuth (optional, bỏ trống nếu không dùng) ──────
LARK_APP_ID=
LARK_APP_SECRET=
# Phải khớp Redirect URL đã add trong Lark Developer Console
LARK_REDIRECT_URI=https://yourdomain.com/auth/lark/callback
# Optional whitelist email/phone (để trống = cho phép mọi user Lark trong workspace)
# LARK_ALLOWED_EMAILS=user1@yourcompany.com,user2@yourcompany.com

# ─── Default admin (chỉ dùng nếu users.json trống) ───
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeMeStrongPassword

# ─── TikTok scrape options (optional) ───
# Browser engine: webkit (default, ít bị TikTok detect) / chromium / firefox
# TIKTOK_BROWSER=webkit
# Headless mode: true (default) / false (hiện browser window, anti-detect mạnh hơn)
# TIKTOK_HEADLESS=true
# Giây sleep giữa requests
# TIKTOK_SLEEP_AFTER=5
